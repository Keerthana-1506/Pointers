#include <stdio.h>

int main() {
    char str[] = "Hello World";
    char *ptr = str;
    int count = 0;

    while(*ptr != '\0') {
        if(*ptr=='a' || *ptr=='e' || *ptr=='i' || *ptr=='o' || *ptr=='u' ||
           *ptr=='A' || *ptr=='E' || *ptr=='I' || *ptr=='O' || *ptr=='U')
            count++;

        ptr++;
    }

    printf("Number of vowels = %d", count);

    return 0;
