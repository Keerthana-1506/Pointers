int main() {
    char str1[] = "hello";
    char str2[] = "hello";

    char *p1 = str1;
    char *p2 = str2;

    while(*p1 && *p2) {
        if(*p1 != *p2) {
            printf("Strings are not equal");
            return 0;
        }
        p1++;
        p2++;
    }

    if(*p1 == '\0' && *p2 == '\0')
        printf("Strings are equal");
    else
        printf("Strings are not equal");

    return 0;
}
