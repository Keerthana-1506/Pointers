#include <stdio.h>

int main() {
    int num = 10;
    int *ptr;

    ptr = &num;   // Store address of num in pointer

    printf("Value of num = %d\n", num);
    printf("Address of num = %p\n", (void *)&num);
    printf("Pointer value (address) = %p\n", (void *)ptr);
    printf("Value using pointer = %d\n", *ptr);

    return 0;
}
